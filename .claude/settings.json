{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash *)",
      "Bash(git push *)",
      "Bash(node _flujo/validar.mjs)",
      "Bash(node _flujo/validar.mjs *)",
      "Bash(echo *)",
      "Bash(node _flujo/estado.mjs *)"
    ],
    "ask": [
      "Bash(*estado.mjs*aprobar*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Edit(/.claude/settings*.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/_flujo/guardia-aprobar.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
